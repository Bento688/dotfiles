# =========================================================
# OpenCode
# =========================================================

opencode() {
  if (( $# > 0 )); then
    command opencode "$@"
    return
  fi

  if [[ -f .env ]]; then
    echo "Loading local environment variables from .env..."
    export $(grep -v '^#' .env | xargs)
  fi

  local port=4096

  while lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; do
    ((port++))
  done

  echo "Starting OpenCode on port $port"

  command opencode --port "$port"
}

alias oc=opencode

