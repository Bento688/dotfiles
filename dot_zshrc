# =========================================================
# Oh My Zsh
# =========================================================
# source /opt/homebrew/opt/zsh-vi-mode/share/zsh-vi-mode/zsh-vi-mode.plugin.zsh
export ZSH="$HOME/.oh-my-zsh"

# No theme — use a minimal native Zsh prompt instead.
ZSH_THEME=""

plugins=(
  git
  zsh-autosuggestions
  zsh-syntax-highlighting
  web-search
  # vi-mode
)

source "$ZSH/oh-my-zsh.sh"


# =========================================================
# Prompt
# =========================================================

autoload -Uz vcs_info
autoload -Uz add-zsh-hook

FIRST_PROMPT=true
LAST_COMMAND=""

remember_command() {
  LAST_COMMAND="$1"
}

draw_prompt() {
  if [[ "$FIRST_PROMPT" == false && "$LAST_COMMAND" != "clear" ]]; then
    print
  fi

  FIRST_PROMPT=false

  if (( COLUMNS < 80 )); then
    PROMPT_PATH_WIDTH=25
    PROMPT_BRANCH_WIDTH=15
  elif (( COLUMNS < 120 )); then
    PROMPT_PATH_WIDTH=35
    PROMPT_BRANCH_WIDTH=20
  else
    PROMPT_PATH_WIDTH=50
    PROMPT_BRANCH_WIDTH=30
  fi

  vcs_info
}

function +vi-truncate_branch() {
  local branch="${hook_com[branch]}"
  local max=$PROMPT_BRANCH_WIDTH

  if (( ${#branch} > max )); then
    hook_com[branch]="${branch[1,$((max - 1))]}…"
  fi
}

add-zsh-hook preexec remember_command
add-zsh-hook precmd draw_prompt

zstyle ':vcs_info:git:*' formats '  %F{cyan} %b%f'
zstyle ':vcs_info:git+set-message:*' hooks truncate_branch

setopt PROMPT_SUBST

# PROMPT='%F{blue}%${PROMPT_PATH_WIDTH}<…<%~%<<%f${vcs_info_msg_0_}
# ❯ '

PROMPT='%F{blue}%~%f${vcs_info_msg_0_}
❯ '

